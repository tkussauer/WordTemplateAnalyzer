<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.tkussauer</groupId>
        <artifactId>word-template-analyzer</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wta-complexity</artifactId>
    <name>Word Template Analyzer - Anwendung 2: Komplexitaetsbewertung</name>
    <description>Bewertet Word-Vorlagen nach Komplexitaet und ordnet sie T-Shirt-Groessen (S, M, L, XL) zu</description>

    <properties>
        <main.class>com.github.tkussauer.wta.complexity.ComplexityApp</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.tkussauer</groupId>
            <artifactId>wta-common</artifactId>
        </dependency>
        <!-- fuer die Anzahl unterschiedlicher Schriftstile und Formatvorlagen -->
        <dependency>
            <groupId>com.github.tkussauer</groupId>
            <artifactId>wta-font-extractor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
